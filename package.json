{
  "name": "dsh-live-sight",
  "version": "0.2.0",
  "description": "Watch the screen together with your DSH agent: change-gated frames packed into sheets for vision models, and a desktop overlay for the conversation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "overlay", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/win10ogod/dsh-live-sight.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "screen", "vision", "companion"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1 || ~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2 || 0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4 || 3.18.6-alpha.1 || ~3.19.0",
    "@screen-capture/node": "1.1.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
